{
  "manifest_version": 3,
  "name": "eh-Presensi",
  "version": "1.4.35",
  "description": "bantu pegawai yang struggle di jalanan menuju kantor",
  "permissions": ["debugger", "storage", "activeTab", "tabs", "scripting", "proxy", "sidePanel", "alarms", "declarativeNetRequest", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "eh-Presensi"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}